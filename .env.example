# ============================================================
# ENVIRONMENT VARIABLES - Quiz Program Backend
# ============================================================
# Copy this file to .env and fill in the actual values.
# On Render: Set these in Dashboard -> Environment.
# NEVER commit the real .env file to Git!
# ============================================================

# ============================================================
# REQUIRED - App will not start without these
# ============================================================

# MongoDB connection string (from MongoDB Atlas)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/quiz_program?retryWrites=true&w=majority

# JWT secrets (use strong random strings - at least 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production

# ============================================================
# RECOMMENDED - Set these for proper functionality
# ============================================================

# Node environment (development | production)
NODE_ENV=production

# Server port (Render sets this automatically)
PORT=5000

# JWT expiry durations
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# Frontend URL (Cloudflare Pages)
# Comma-separated for multiple: https://your-quiz.pages.dev,https://quiz.yourdomain.com
FRONTEND_URL=https://your-quiz.pages.dev

# Backend URL (Render auto-detects RENDER_EXTERNAL_URL, but set explicitly if custom domain)
BACKEND_URL=https://your-backend.onrender.com

# ============================================================
# EMAIL - Brevo (Sendinblue) SMTP
# ============================================================
# Sign up at https://www.brevo.com (free 300 emails/day)
# SMTP credentials: Dashboard -> SMTP & API -> SMTP tab

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login@example.com
SMTP_PASS=your-brevo-smtp-password
EMAIL_FROM=Quiz Program <noreply@yourdomain.com>

# Legacy Gmail variables (deprecated - kept for backward compat, unused)
EMAIL_USER=
EMAIL_PASS=

# ============================================================
# FILE STORAGE - Cloudflare R2
# ============================================================
# Sign up at https://dash.cloudflare.com -> R2
# Create bucket, generate API token with R2 read/write

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY=your-r2-access-key-id
R2_SECRET_KEY=your-r2-secret-access-key
R2_BUCKET=quiz-program-storage
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxx.r2.dev
# Or custom domain: https://cdn.yourdomain.com

# ============================================================
# OPTIONAL
# ============================================================

# Google Gemini AI (for future AI features)
GEMINI_API_KEY=your-gemini-api-key

# ============================================================
# DO NOT SET THESE MANUALLY (Render auto-provides)
# ============================================================
# RENDER_EXTERNAL_URL - Render sets this automatically
# RENDER_SERVICE_ID  - Render sets this automatically